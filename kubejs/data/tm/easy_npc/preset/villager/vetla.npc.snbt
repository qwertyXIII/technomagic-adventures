        {
          Label:"default",
          Name:"Ветла",
          Texts:[
            {
              Text:"Поешь, @initiator. Голодный — глупый, сытый — умный. Так говорят."
            },
            {
              Text:"Звезда упала, и все уснули. А утром встали — и как будто не ложились. Так бабушка говорила. А ей — её бабушка."
            }
          ],

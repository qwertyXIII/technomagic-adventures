        {
          Label:"default",
          Name:"Ош",
          Texts:[
            {
              Text:"Мы… я — Ош. Архивариус. Не убивай. Книги без меня одичают."
            }
          ],
          Priority:10,
          Buttons:[
            {
              Label:"b_default_0",
              Name:"Кто вы такие?",

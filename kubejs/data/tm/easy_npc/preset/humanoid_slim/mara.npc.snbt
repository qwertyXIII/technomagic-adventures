      DialogDataSet:[
        {
          Label:"default",
          Name:"Мара",
          Texts:[
            {
              Text:"Пришли. Хорошо. Он проснулся наполовину и зовёт меня по имени — единственный, кто его ещё помнит. Не стойте близко к раме."
            }
          ],
          Priority:10,
          Buttons:[
            {
              Label:"b_default_0",
              Name:"Кто ты?",
              Actions:[
                {
                  Type:"OPEN_NAMED_DIALOG",
                  Cmd:"who"
                }
              ]
            },
            {
              Label:"b_default_1",
              Name:"Что в контейнере?",
              Actions:[
                {
                  Type:"OPEN_NAMED_DIALOG",
                  Cmd:"lethe"
                }
              ]
            },
            {
              Label:"b_default_2",
              Name:"ЛОЦМАН говорит, есть другой путь",
              Actions:[
                {
                  Type:"OPEN_NAMED_DIALOG",
                  Cmd:"other"
                }
              ]
            },
            {
              Label:"b_default_3",
              Name:"Почему ты не сделала это сама?",
              Actions:[
                {
                  Type:"OPEN_NAMED_DIALOG",
                  Cmd:"why"
                }
              ]
            },
            {
              Label:"b_default_4",
              Name:"Нам нужно время",
              Actions:[
                {
                  Type:"OPEN_NAMED_DIALOG",
                  Cmd:"time"
                }
              ]
            }
          ],
          Conditions:[
            {
              Type:"SCOREBOARD",
              Name:"tm_story",
              Operation:"LESS_THAN",
              Value:10
            }
          ]
        },
        {
          Label:"final_a",
          Name:"Мара",
          Texts:[
            {
              Text:"Пойдёмте наверх. Я обещала Ветле научить её внуков считать."
            }
          ],
          Priority:30,
          Buttons:[
            {
              Label:"b_final_a_0",
              Name:"Пойдём",
              Actions:[
                {
                  Type:"CLOSE_DIALOG"
                }
              ]
            }
          ],
          Conditions:[
            {
              Type:"SCOREBOARD",
              Name:"tm_story",
              Operation:"EQUALS",
              Value:10
            }
          ]
        },
        {
          Label:"final_b",
          Name:"Мара",
          Texts:[
            {
              Text:"Теперь они вспомнят и меня. Пусть. Это честно."
            }
          ],
          Priority:30,
          Buttons:[
            {
              Label:"b_final_b_0",
              Name:"…",
              Actions:[
                {
                  Type:"CLOSE_DIALOG"
                }
              ]
            }
          ],
          Conditions:[
            {
              Type:"SCOREBOARD",
              Name:"tm_story",
              Operation:"EQUALS",
              Value:11
            }
          ]
        },
        {
          Label:"final_c",
          Name:"Мара",
          Texts:[
            {
              Text:"Привет. Это я. Мы. …Я."
            }
          ],
          Priority:30,
          Buttons:[
            {
              Label:"b_final_c_0",
              Name:"…",
              Actions:[
                {
                  Type:"CLOSE_DIALOG"
                }
              ]
            }
          ],
          Conditions:[
            {
              Type:"SCOREBOARD",
              Name:"tm_story",
              Operation:"EQUALS",
              Value:12
            }
          ]
        },
        {
          Label:"who",
          Name:"who",
          Texts:[
            {
              Text:"Вы уже знаете. Вы были на Гласио, вы читали метрику. Мара. Та, что выбрала вам лица. Простите за это. Или не прощайте — как вам удобнее."
            }
          ],
          Priority:0,
          Buttons:[
            {
              Label:"b_who_0",
              Name:"…",
              Actions:[
                {
                  Type:"OPEN_NAMED_DIALOG",
                  Cmd:"default"
                }
              ]
            },
            {
              Label:"b_who_1",
              Name:"Пока",
              Actions:[
                {
                  Type:"CLOSE_DIALOG"
                }
              ]
            }
          ]
        },
        {
          Label:"lethe",
          Name:"lethe",
          Texts:[
            {
              Text:"Лета-2. Она не тронет живых. Только его — и всё, что он хранит. Шестьсот сорок один год чужих жизней. Мамы, сказки, рецепты хлеба, первые слова детей. Всё сгорит, и больше никто никогда не придёт за вами с распростёртыми объятиями."
            }
          ],
          Priority:0,
          Buttons:[
            {
              Label:"b_lethe_0",
              Name:"…",
              Actions:[
                {
                  Type:"OPEN_NAMED_DIALOG",
                  Cmd:"default"
                }
              ]
            },
            {
              Label:"b_lethe_1",
              Name:"Пока",
              Actions:[
                {
                  Type:"CLOSE_DIALOG"
                }
              ]
            }
          ]
        },
        {
          Label:"other",
          Name:"other",
          Texts:[
            {
              Text:"Конечно, говорит. Она — это я, которой повезло не помнить. Она росла с вами, смотрела, как вы кормите кур и учите детей считать. Она лучше меня. Это не значит, что она права."
            }
          ],
          Priority:0,
          Buttons:[
            {
              Label:"b_other_0",
              Name:"…",
              Actions:[
                {
                  Type:"OPEN_NAMED_DIALOG",
                  Cmd:"default"
                }
              ]
            },
            {
              Label:"b_other_1",
              Name:"Пока",
              Actions:[
                {
                  Type:"CLOSE_DIALOG"
                }
              ]
            }
          ]
        },
        {
          Label:"why",
          Name:"why",
          Texts:[
            {
              Text:"Потому что один раз уже сделала. Я обещала себе — той, в стеке, — что второе решение будет не моим. Вы чистые. Вас не было в той ночи. Вам и решать."
            }
          ],
          Priority:0,
          Buttons:[
            {
              Label:"b_why_0",
              Name:"…",
              Actions:[
                {
                  Type:"OPEN_NAMED_DIALOG",
                  Cmd:"default"
                }
              ]
            },
            {
              Label:"b_why_1",
              Name:"Пока",
              Actions:[

            },
            {
              Label:"b_count_1",
              Name:"Пока",
              Actions:[
                {
                  Type:"CLOSE_DIALOG"
                }
              ]
            }
          ]
        },
        {
          Label:"emerald",
          Name:"emerald",
          Texts:[
            {
              Text:"Изумруд не трожь. Он чей-то. Мой вот — мой. А твой где? Нет у тебя? Ох, бедный. Совсем без имени."
            }
          ],
          Priority:0,
          Buttons:[
            {
              Label:"b_emerald_0",
              Name:"…",
              Actions:[
                {
                  Type:"OPEN_NAMED_DIALOG",
                  Cmd:"default"

  "ie.manual.entry.blank_text": "",
  "ie.manual.entry.reservoirs.bio.any": "Это месторождение может появиться в любом биоме.",
  "ie.manual.entry.reservoirs.bio.invalid": "Это месторождение не появится в биомах: %s.",
